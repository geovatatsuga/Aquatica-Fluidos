import { Aperture, ChevronDown, RotateCcw, SlidersHorizontal } from "lucide-react";
import { useState, type CSSProperties } from "react";
import { useOceanStore } from "../store/oceanStore";

type SliderProps = {
  label: string; hint: string; value: number; min: number; max: number; step: number;
  onChange: (value: number) => void;
};

function Slider({ label, hint, value, min, max, step, onChange }: SliderProps) {
  const intensity = Math.max(0, Math.min(100, ((value - min) / (max - min)) * 100));
  return (
    <label className="lab-slider" style={{ "--value": `${intensity}%` } as CSSProperties}>
      <span><span>{label}<small>{hint}</small></span><b>{Math.round(intensity)}<i>%</i></b></span>
      <input aria-label={label} type="range" value={value} min={min} max={max} step={step}
        onChange={(event) => onChange(Number(event.target.value))} />
    </label>
  );
}

export default function ControlPanel() {
  const simulation = useOceanStore();
  const [open, setOpen] = useState(true);

  return (
    <aside className={`lab-controls${open ? "" : " is-collapsed"}`}>
      <header>
        <span><SlidersHorizontal size={14} /> FLUIDO</span>
        <button aria-label={open ? "Recolher controles" : "Abrir controles"} onClick={() => setOpen(!open)}><ChevronDown size={14} /></button>
      </header>
      <div className="control-body">
        <section className="field-status"><span><i /> CAMPO ATIVO</span><b>{simulation.preset.toUpperCase()}</b></section>
        <section className="living-controls">
          <Slider label="FLUXO" hint="velocidade" value={simulation.waveSpeed} min={.1} max={4} step={.1} onChange={simulation.setWaveSpeed} />
          <Slider label="COESÃO" hint="massa" value={simulation.waveHeight} min={.05} max={1.5} step={.01} onChange={simulation.setWaveHeight} />
          <Slider label="TURBULÊNCIA" hint="dispersão" value={simulation.particleDensity} min={0} max={2000} step={25} onChange={simulation.setParticleDensity} />
          <Slider label="MAGNETISMO" hint="frequência" value={simulation.waveFrequency} min={.2} max={2.5} step={.05} onChange={simulation.setWaveFrequency} />
          <Slider label="PULSO" hint="energia" value={simulation.foamIntensity} min={0} max={2} step={.05} onChange={simulation.setFoamIntensity} />
        </section>
        <section className="control-actions">
          <button onClick={() => simulation.setCameraMode(simulation.cameraMode === "orbit" ? "cinematic" : "orbit")}><Aperture size={11} /> {simulation.cameraMode === "orbit" ? "ÓRBITA" : "CINEMA"}</button>
          <button aria-label="Restaurar preset" onClick={() => simulation.resetToPreset(simulation.preset)}><RotateCcw size={11} /> RESET</button>
        </section>
      </div>
    </aside>
  );
}
